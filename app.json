{
  "name": "Predictor Bot",
  "description": "Telegram bot to force users to subscribe a particular chat",
  "logo": "https://graph.org/file/4a0df73c438e618ac337d.jpg",
  "keywords": [
    "telegram",
    "mongodb"
    "bot",
    "python",
    "pyrogram"
  ],
    "buildpacks": [{
    "url": "heroku/python"
  }],
  "addons": [
        {
            "plan": "heroku-postgresql"
        }
    ],
  "repository": "https://github.com/AerodynamicV1Botz/PredictorAerobot",
  "env": {
    "ENVIRONMENT": {
      "description": "Don't change ANYTHING.",
      "required": true,
      "value": "ANYTHING"
    },
    "API_ID": {
      "description": "Get this value from my.telegram.org.",
      "required": true,
      "value": ""
    },
    "API_HASH": {
      "description": "Get this value from my.telegram.org.",
      "required": true,
      "value": ""
    },
    "BOT_TOKEN": {
      "description": "Obtain a Telegram bot token by contacting @BotFather",
      "required": true,
      "value": ""
    },
      "LOG_GROUP_ID": {
        "description": "A group id to forward the incoming messages in it.",
        "required": true,
        "value": ""
    },
      "MONGO_DB_URI": {
        "description": "Get a mongodb url from https://cloud.mongodb.com.",
        "required": false,
        "value": ""
    },
      "PRIVATE_START_MESSAGE": {
        "description": "A welcome message for your bot when someone starts it",
        "required": true,
        "value": ""
    },
      "SUDO_USER": {
        "description": "The user id(s) of user(s) whom you would like to add as a SUDO_USER, Multiple values shall be seperated with a space.",
        "required": true,
        "value": ""
    },
    "START_IMG": {
      "description": "Fill Start Img url below",
      "required": true,
      "value": "https://graph.org/file/4a0df73c438e618ac337d.jpg"
    },
    "MUST_JOIN": {
      "description": "Add username/id of a channel/group",
      "required": false,
      "value": ""
    }
  }
}
